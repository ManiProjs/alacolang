{
  "name": "alaco-language",
  "displayName": "Alaco Language Support",
  "description": "Alaco language support with syntax highlighting, compiler commands, and a built-in LSP client.",
  "version": "0.2.0",
  "publisher": "alaco-language",
  "license": "MIT",
  "repository": "https://github.com/ManiProjs/alaco.git",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:alaco"
  ],
  "contributes": {
    "configuration": {
      "title": "Alaco",
      "properties": {
        "alaco.executable": {
          "type": "string",
          "default": "alaco",
          "description": "Path to the Alaco executable, including its lsp subcommand."
        },
        "alaco.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the Alaco language server for editor intelligence."
        }
      }
    },
    "languages": [
      {
        "id": "alaco",
        "aliases": [
          "Alaco",
          "alaco"
        ],
        "extensions": [
          ".aco"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "alaco",
        "scopeName": "source.alaco",
        "path": "./syntaxes/alaco.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "alaco",
        "path": "./snippets/alaco.json"
      }
    ],
    "commands": [
      {
        "command": "alaco.check",
        "title": "Alaco: Check Current File"
      },
      {
        "command": "alaco.build",
        "title": "Alaco: Build Current File"
      },
      {
        "command": "alaco.run",
        "title": "Alaco: Run Current File"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "alaco.run",
          "when": "resourceExtname == .aco",
          "group": "navigation@99"
        }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
