// `previous` remembers the value before the most recent assignment.
// `when` checks its condition after statements in this block.
fn main() {
    let mut score = 0;

    when score != previous score {
        println("Score changed: ${score}");
    }

    score = 1;
    score = 2;
    score = 2; // No event: the value did not change.
    score = 3;
}
