fn max(a: Int, b: Int) -> Int {
    if a > b {
        return a;
    }

    return b;
}

fn min(a: Int, b: Int) -> Int {
    if a < b {
        return a;
    }

    return b;
}

fn abs(value: Int) -> Int {
    if value < 0 {
        return 0 - value;
    }

    return value;
}

fn square(value: Int) -> Int {
    return value * value;
}

fn clamp(value: Int, lower: Int, upper: Int) -> Int {
    if value < lower {
        return lower;
    }

    if value > upper {
        return upper;
    }

    return value;
}

fn is_even(value: Int) -> Bool {
    return value % 2 == 0;
}

fn is_odd(value: Int) -> Bool {
    return value % 2 != 0;
}

fn cube(value: Int) -> Int {
    return value * value * value;
}

fn sign(value: Int) -> Int {
    if value < 0 {
        return -1;
    }
    if value > 0 {
        return 1;
    }
    return 0;
}

fn in_range(value: Int, lower: Int, upper: Int) -> Bool {
    if value < lower {
        return false;
    }
    return value <= upper;
}

// Greatest common divisor of two integers (Euclidean algorithm).
fn gcd(left: Int, right: Int) -> Int {
    let mut a = abs(left);
    let mut b = abs(right);
    loop (while b != 0) {
        let remainder = a % b;
        a = b;
        b = remainder;
    }
    return a;
}

// Integer exponentiation. Non-positive exponents return 1.
fn pow_int(base: Int, exponent: Int) -> Int {
    let mut result = 1;
    let mut count = 0;
    loop (while count < exponent) {
        result = result * base;
        count = count + 1;
    }
    return result;
}

// Least common multiple. Returns zero when either input is zero.
fn lcm(left: Int, right: Int) -> Int {
    if left == 0 {
        return 0;
    }
    if right == 0 {
        return 0;
    }
    return abs((left / gcd(left, right)) * right);
}

fn is_prime(value: Int) -> Bool {
    if value < 2 {
        return false;
    }
    let mut divisor = 2;
    loop (while divisor <= value / divisor) {
        if value % divisor == 0 {
            return false;
        }
        divisor = divisor + 1;
    }
    return true;
}

// Factorial for 0..=20. Returns -1 for negative values or values that would
// overflow a signed 64-bit integer.
fn factorial(value: Int) -> Int {
    if value < 0 or value > 20 {
        return -1;
    }
    let mut result = 1;
    let mut factor = 2;
    loop (while factor <= value) {
        result = result * factor;
        factor = factor + 1;
    }
    return result;
}

// Round integer division upward. Returns 0 for a zero divisor.
fn ceil_div(value: Int, divisor: Int) -> Int {
    if divisor == 0 {
        return 0;
    }
    let quotient = value / divisor;
    let remainder = value % divisor;
    if remainder != 0 and ((value > 0 and divisor > 0) or (value < 0 and divisor < 0)) {
        return quotient + 1;
    }
    return quotient;
}

fn triangular(value: Int) -> Int {
    if value < 0 or value > 3037000499 {
        return -1;
    }
    return (value * (value + 1)) / 2;
}

fn is_power_of_two(value: Int) -> Bool {
    if value <= 0 {
        return false;
    }
    let mut remaining = value;
    loop (while remaining % 2 == 0) {
        remaining = remaining / 2;
    }
    return remaining == 1;
}

// Return false for a zero divisor instead of evaluating remainder by zero.
fn is_multiple_of(value: Int, divisor: Int) -> Bool {
    if divisor == 0 {
        return false;
    }
    return value % divisor == 0;
}

// Return the first multiple of `step` greater than or equal to `value`.
// A non-positive step returns `value` unchanged.
fn round_up_to_multiple(value: Int, step: Int) -> Int {
    if step <= 0 {
        return value;
    }
    let remainder = value % step;
    if remainder == 0 {
        return value;
    }
    if value >= 0 {
        return value + step - remainder;
    }
    return value - remainder;
}
