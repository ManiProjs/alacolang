// Environment access. Missing variables read as an empty string; use has()
// to distinguish a missing variable from one explicitly set to empty.
fn get(name: String) -> String {
    return __builtin_env_get(name);
}

fn has(name: String) -> Bool {
    return __builtin_env_has(name);
}

fn set(name: String, value: String) -> Bool {
    return __builtin_env_set(name, value);
}

fn current_dir() -> String {
    return __builtin_env_current_dir();
}
