fn sum3(a: Int, b: Int, c: Int) -> Int {
    return a + b + c;
}

fn average2(a: Int, b: Int) -> Int {
    return (a + b) / 2;
}

fn average3(a: Int, b: Int, c: Int) -> Int {
    return (a + b + c) / 3;
}

fn min2(a: Int, b: Int) -> Int {
    if a < b {
        return a;
    }
    return b;
}

fn max2(a: Int, b: Int) -> Int {
    if a > b {
        return a;
    }
    return b;
}

fn min3(a: Int, b: Int, c: Int) -> Int {
    let first = min2(a, b);
    return min2(first, c);
}

fn max3(a: Int, b: Int, c: Int) -> Int {
    let first = max2(a, b);
    return max2(first, c);
}

// Return the middle value without sorting or allocating a collection.
fn median3(a: Int, b: Int, c: Int) -> Int {
    if a <= b {
        if b <= c {
            return b;
        }
        if a <= c {
            return c;
        }
        return a;
    }
    if a <= c {
        return a;
    }
    if b <= c {
        return c;
    }
    return b;
}

fn sum4(a: Int, b: Int, c: Int, d: Int) -> Int {
    return a + b + c + d;
}

fn average4(a: Int, b: Int, c: Int, d: Int) -> Int {
    return (a + b + c + d) / 4;
}

// Integer percentage. Returns 0 when total is zero.
fn percentage(value: Int, total: Int) -> Int {
    if total == 0 {
        return 0;
    }
    return (value * 100) / total;
}
