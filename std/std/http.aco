// No external curl executable is spawned. Windows uses WinHTTP, macOS uses
// CFNetwork, and other Unix-like systems use OpenSSL for HTTPS plus native
// sockets. Failed requests and non-2xx responses return an empty string.
fn is_url(url: String) -> Bool {
    return __builtin_http_is_url(url);
}

fn get(url: String) -> String {
    return __builtin_http_get(url);
}

fn post_json(url: String, body: String) -> String {
    return __builtin_http_post(url, body);
}
